{
  "name": "biblioteca-de-monstros-digital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "11.29.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "schemas:generate": "node scripts/generate-types.mjs",
    "schemas:check": "node scripts/generate-types.mjs --check",
    "portable:check": "node scripts/check-portable-schemas.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "ajv": "8.17.1",
    "fflate": "0.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "5.1.1"
  }
}
