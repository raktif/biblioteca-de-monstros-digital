{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblioteca-de-monstros-digital.local/schemas/portable/v1/manifest.schema.json",
  "title": "Manifesto de pacote portátil BMD v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "formatVersion", "kind", "packageKind", "systemCode", "schemaKey", "schemaVersion", "exportedAt", "generator", "counts", "totalUncompressedBytes", "files"],
  "properties": {
    "format": { "const": "biblioteca-de-monstros-digital.package" }, "formatVersion": { "const": 1 }, "kind": { "const": "package-manifest" },
    "packageKind": { "enum": ["library", "monster"] }, "systemCode": { "enum": ["add2e", "shadowlords3e"] },
    "schemaKey": { "enum": ["add2e.monster", "shadowlords3e.monster"] }, "schemaVersion": { "type": "integer", "minimum": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "Biblioteca de Monstros Digital" }, "version": { "type": "string", "minLength": 1, "maxLength": 40 } } },
    "counts": { "type": "object", "additionalProperties": false, "required": ["libraries", "monsters", "activeMonsters", "archivedMonsters", "images", "files"], "properties": { "libraries": { "type": "integer", "minimum": 0, "maximum": 1 }, "monsters": { "type": "integer", "minimum": 0, "maximum": 10000 }, "activeMonsters": { "type": "integer", "minimum": 0, "maximum": 10000 }, "archivedMonsters": { "type": "integer", "minimum": 0, "maximum": 10000 }, "images": { "type": "integer", "minimum": 0, "maximum": 10001 }, "files": { "type": "integer", "minimum": 1, "maximum": 25000 } } },
    "totalUncompressedBytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
    "files": { "type": "array", "minItems": 1, "maxItems": 25000, "items": { "type": "object", "additionalProperties": false, "required": ["path", "role", "mediaType", "size", "sha256"], "properties": { "path": { "$ref": "common.schema.json#/$defs/portablePath" }, "role": { "enum": ["library-data", "monster-data", "library-image", "monster-image"] }, "mediaType": { "enum": ["application/json", "image/jpeg", "image/png", "image/webp"] }, "size": { "type": "integer", "minimum": 1, "maximum": 16777216 }, "sha256": { "$ref": "common.schema.json#/$defs/sha256" } } } }
  }
}
