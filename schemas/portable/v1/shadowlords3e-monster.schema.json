{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblioteca-de-monstros-digital.local/schemas/portable/v1/shadowlords3e-monster.schema.json",
  "title": "Monstro portátil Shadowlords Mini System 3E BMD v1", "type": "object", "additionalProperties": false,
  "required": ["format", "formatVersion", "kind", "systemCode", "schemaKey", "schemaVersion", "monster"],
  "properties": {
    "format": { "const": "biblioteca-de-monstros-digital.shadowlords3e.monster" }, "formatVersion": { "const": 1 }, "kind": { "const": "monster" }, "systemCode": { "const": "shadowlords3e" }, "schemaKey": { "const": "shadowlords3e.monster" }, "schemaVersion": { "type": "integer", "minimum": 1 }, "monster": { "$ref": "#/$defs/monster" }
  },
  "$defs": {
    "text": { "type": ["string", "null"], "maxLength": 50000 },
    "codeOther": { "type": "object", "additionalProperties": false, "required": ["code", "other"], "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_]*$" }, "other": { "type": ["string", "null"], "maxLength": 240 } } },
    "skill": { "type": "object", "additionalProperties": false, "required": ["name", "modifier", "notes"], "properties": { "name": { "type": "string" }, "modifier": { "type": "integer", "minimum": 1, "maximum": 3 }, "notes": { "$ref": "#/$defs/text" } } },
    "trait": { "type": "object", "additionalProperties": false, "required": ["name", "category", "summary", "details", "uses", "recharge"], "properties": { "name": { "type": "string" }, "category": { "type": "string" }, "summary": { "type": "string" }, "details": { "$ref": "#/$defs/text" }, "uses": { "$ref": "#/$defs/text" }, "recharge": { "$ref": "#/$defs/text" } } },
    "spell": { "type": "object", "additionalProperties": false, "required": ["name", "mode", "castingSkill", "pvCost", "uses", "recharge", "notes"], "properties": { "name": { "type": "string" }, "mode": { "type": "string" }, "castingSkill": { "$ref": "#/$defs/text" }, "pvCost": { "type": ["integer", "null"], "minimum": 0, "maximum": 20 }, "uses": { "$ref": "#/$defs/text" }, "recharge": { "$ref": "#/$defs/text" }, "notes": { "$ref": "#/$defs/text" } } },
    "statistics": { "type": "object", "additionalProperties": false, "required": ["type", "attributes", "hitPoints", "defense", "damageReductions", "attacks", "activeDefense", "skills", "movement", "traits", "spells", "specialsSummary", "dragon"], "properties": { "type": { "const": "shadowlords3e" }, "attributes": { "type": "object", "additionalProperties": false, "required": ["for", "agi", "sau", "int", "sab", "per"], "properties": { "for": { "type": "integer", "minimum": -1, "maximum": 3 }, "agi": { "type": "integer", "minimum": -1, "maximum": 3 }, "sau": { "type": "integer", "minimum": -1, "maximum": 3 }, "int": { "type": "integer", "minimum": -1, "maximum": 3 }, "sab": { "type": "integer", "minimum": -1, "maximum": 3 }, "per": { "type": "integer", "minimum": -1, "maximum": 3 } } }, "hitPoints": { "type": "integer", "minimum": 1, "maximum": 250 }, "defense": { "type": "object", "additionalProperties": false, "required": ["natural", "armorBonus", "shieldBonus", "magicBonus", "otherBonus", "otherDescription", "final"], "properties": { "natural": { "type": "integer", "minimum": 10, "maximum": 15 }, "armorBonus": { "type": "integer", "minimum": -10, "maximum": 20 }, "shieldBonus": { "type": "integer", "minimum": 0, "maximum": 5 }, "magicBonus": { "type": "integer", "minimum": -10, "maximum": 20 }, "otherBonus": { "type": "integer", "minimum": -10, "maximum": 20 }, "otherDescription": { "$ref": "#/$defs/text" }, "final": { "type": "integer", "minimum": -20, "maximum": 100 } } }, "damageReductions": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["source", "value", "damageTypes", "usesMode", "uses", "notes"], "properties": { "source": { "type": "string" }, "value": { "type": "integer", "minimum": 0, "maximum": 10 }, "damageTypes": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "usesMode": { "enum": ["limited", "unlimited", "special"] }, "uses": { "type": ["integer", "null"], "minimum": 1, "maximum": 15 }, "notes": { "$ref": "#/$defs/text" } } } }, "attacks": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "attackFormula", "attackNotes", "damageFormula", "damageType", "range", "usageInterval", "notes"], "properties": { "name": { "type": "string" }, "attackFormula": { "type": "string" }, "attackNotes": { "$ref": "#/$defs/text" }, "damageFormula": { "type": "string" }, "damageType": { "type": "string" }, "range": { "type": "string" }, "usageInterval": { "type": "string" }, "notes": { "$ref": "#/$defs/text" } } } }, "activeDefense": { "type": "object", "additionalProperties": false, "required": ["enabled", "formula", "cost", "restrictions", "notes"], "properties": { "enabled": { "type": "boolean" }, "formula": { "$ref": "#/$defs/text" }, "cost": { "$ref": "#/$defs/text" }, "restrictions": { "$ref": "#/$defs/text" }, "notes": { "$ref": "#/$defs/text" } } }, "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } }, "movement": { "type": "string" }, "traits": { "type": "array", "items": { "$ref": "#/$defs/trait" } }, "spells": { "type": "array", "items": { "$ref": "#/$defs/spell" } }, "specialsSummary": { "type": "string" }, "dragon": { "type": ["object", "null"] } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["label", "kind", "isPrimary", "climates", "terrains", "climateTerrainNotes", "frequency", "organization", "activityPeriods", "activityNotes", "diet", "quantityEncounter", "size", "morale", "treasure", "specialDefensesSummary", "magicProtectionSummary", "profileNotes", "statistics"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "type": "string" }, "isPrimary": { "type": "boolean" }, "climates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/codeOther" } }, "terrains": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/codeOther" } }, "climateTerrainNotes": { "$ref": "#/$defs/text" }, "frequency": { "$ref": "#/$defs/codeOther" }, "organization": { "type": "string" }, "activityPeriods": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/codeOther" } }, "activityNotes": { "$ref": "#/$defs/text" }, "diet": { "type": "string" }, "quantityEncounter": { "type": "string" }, "size": { "type": "string" }, "morale": { "type": "integer", "minimum": 0, "maximum": 3 }, "treasure": { "type": "string" }, "specialDefensesSummary": { "type": ["string", "null"] }, "magicProtectionSummary": { "type": ["string", "null"] }, "profileNotes": { "$ref": "#/$defs/text" }, "statistics": { "$ref": "#/$defs/statistics" } } },
    "monster": { "type": "object", "additionalProperties": false, "required": ["name", "descriptors", "dragonModuleEnabled", "status", "image", "narratives", "profiles", "sources"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "descriptors": { "type": "array", "maxItems": 6, "items": { "type": "string" } }, "dragonModuleEnabled": { "type": "boolean" }, "status": { "$ref": "common.schema.json#/$defs/status" }, "image": { "oneOf": [{ "$ref": "common.schema.json#/$defs/imageRef" }, { "type": "null" }] }, "narratives": { "type": "object", "additionalProperties": false, "required": ["description", "combat", "habitatSociety", "ecology", "tactics", "variations", "additionalNotes"], "properties": { "description": { "type": "string" }, "combat": { "type": "string" }, "habitatSociety": { "type": "string" }, "ecology": { "type": "string" }, "tactics": { "$ref": "#/$defs/text" }, "variations": { "$ref": "#/$defs/text" }, "additionalNotes": { "$ref": "#/$defs/text" } } }, "profiles": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/profile" } }, "sources": { "type": "array", "maxItems": 10, "items": { "$ref": "common.schema.json#/$defs/source" } } } }
  }
}
