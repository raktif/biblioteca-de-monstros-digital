{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biblioteca-de-monstros-digital.local/schemas/portable/v1/add2e-monster.schema.json",
  "title": "Monstro portátil AD&D 2ª Edição BMD v1", "type": "object", "additionalProperties": false,
  "required": ["format", "formatVersion", "kind", "systemCode", "schemaKey", "schemaVersion", "monster"],
  "properties": {
    "format": { "const": "biblioteca-de-monstros-digital.add2e.monster" }, "formatVersion": { "const": 1 }, "kind": { "const": "monster" }, "systemCode": { "const": "add2e" }, "schemaKey": { "const": "add2e.monster" }, "schemaVersion": { "type": "integer", "minimum": 1 },
    "monster": { "$ref": "#/$defs/add2eMonster" }
  },
  "$defs": {
    "text": { "type": ["string", "null"], "maxLength": 50000 },
    "codeOther": { "type": "object", "additionalProperties": false, "required": ["code", "other"], "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_]*$" }, "other": { "type": ["string", "null"], "maxLength": 240 } } },
    "profile": { "type": "object", "additionalProperties": false, "required": ["label", "kind", "isPrimary", "climates", "terrains", "climateTerrainNotes", "frequency", "organization", "activityPeriods", "activityNotes", "diet", "treasure", "quantityEncounter", "size", "morale", "profileNotes", "statistics"], "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 120 }, "kind": { "type": "string", "minLength": 1, "maxLength": 40 }, "isPrimary": { "type": "boolean" }, "climates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/codeOther" } }, "terrains": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/codeOther" } }, "climateTerrainNotes": { "$ref": "#/$defs/text" }, "frequency": { "$ref": "#/$defs/codeOther" }, "organization": { "type": "string", "minLength": 1, "maxLength": 120 }, "activityPeriods": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/codeOther" } }, "activityNotes": { "$ref": "#/$defs/text" }, "diet": { "type": "string", "minLength": 1, "maxLength": 120 }, "treasure": { "type": "string", "minLength": 1, "maxLength": 500 }, "quantityEncounter": { "type": "string", "minLength": 1, "maxLength": 120 }, "size": { "type": "string", "minLength": 1, "maxLength": 120 }, "morale": { "type": "string", "minLength": 1, "maxLength": 120 }, "profileNotes": { "$ref": "#/$defs/text" }, "statistics": { "type": "object", "additionalProperties": false, "required": ["type", "intelligence", "alignment", "armorClass", "movement", "hitDice", "thac0", "attacksPerRound", "damagePerAttack", "specialAttacks", "specialDefenses", "magicResistance", "experienceValue", "psionics"], "properties": { "type": { "const": "add2e" }, "intelligence": { "type": "string" }, "alignment": { "type": "string" }, "armorClass": { "type": "string" }, "movement": { "type": "string" }, "hitDice": { "type": "string" }, "thac0": { "type": "string" }, "attacksPerRound": { "type": "string" }, "damagePerAttack": { "type": "string" }, "specialAttacks": { "type": "string" }, "specialDefenses": { "type": "string" }, "magicResistance": { "type": "string" }, "experienceValue": { "type": "string" }, "psionics": {} } } } },
    "add2eMonster": { "type": "object", "additionalProperties": false, "required": ["name", "editorialCategory", "status", "image", "narratives", "profiles", "auxiliaryTables", "sources"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "editorialCategory": { "type": ["string", "null"], "maxLength": 160 }, "status": { "$ref": "common.schema.json#/$defs/status" }, "image": { "oneOf": [{ "$ref": "common.schema.json#/$defs/imageRef" }, { "type": "null" }] }, "narratives": { "type": "object", "additionalProperties": false, "required": ["description", "combat", "habitatSociety", "ecology", "variations", "additionalNotes"], "properties": { "description": { "type": "string" }, "combat": { "type": "string" }, "habitatSociety": { "type": "string" }, "ecology": { "type": "string" }, "variations": { "$ref": "#/$defs/text" }, "additionalNotes": { "$ref": "#/$defs/text" } } }, "profiles": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/profile" } }, "auxiliaryTables": { "type": "array", "maxItems": 10, "items": { "type": "object", "additionalProperties": false, "required": ["title", "columns", "rows", "notes"], "properties": { "title": { "type": "string" }, "columns": { "type": "array" }, "rows": { "type": "array" }, "notes": { "$ref": "#/$defs/text" } } } }, "sources": { "type": "array", "maxItems": 10, "items": { "$ref": "common.schema.json#/$defs/source" } } } }
  }
}
